# إعدادات إرسال البريد الإلكتروني (تأكيد الحساب عبر OTP)
# للحصول على نسبة وصول 100% للبريد الأساسي (Inbox)، ينصح باستخدام خدمات مثل:
# Resend, SendGrid, Amazon SES, أو استخدام Gmail App Password كحل مجاني.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# قم بوضع إيميل الإرسال وكلمة المرور الخاصة بالتطبيقات (App Password)
SMTP_USER=smarteducationauthority@gmail.com
SMTP_PASS=gbls gduo lytz wkdq

# الإيميل الذي سيظهر للعملاء كمرسل
FROM_EMAIL=smarteducationauthority@gmail.com
